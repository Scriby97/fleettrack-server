# Supabase Konfiguration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (optional - falls du Supabase DB nutzt)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Frontend URL (für Invite-Links)
# Development:
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://fleettrack-frontend.vercel.app

# Passwort-Reset Redirect (optional, ueberschreibt FRONTEND_URL + /reset-password)
# Development:
# FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
# Production:
# FRONTEND_RESET_PASSWORD_URL=https://fleettrack-frontend.vercel.app/reset-password

# Port (optional - default 3001)
PORT=3001

# Stripe (Self-Service Organisation-Erstellung, bezahlte Tiers)
# Ohne diese Variablen funktioniert die Erstellung im Lieutenant (Free) Tier weiterhin,
# nur Captain/General benoetigen einen konfigurierten Stripe Account.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CAPTAIN=price_...
STRIPE_PRICE_GENERAL=price_...

# Web Push (taegliche Erfassungserinnerung)
# Schluesselpaar generieren: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:support@fleettrack.app
